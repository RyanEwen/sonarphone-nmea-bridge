<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Legacy/development flavor only: the direct battery-optimisation prompt.
         Public downloads now use the Play flavor and its policy-safe prompt. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <!-- allow `adb shell am start-foreground-service` to drive it in dev -->
        <service
            android:name=".BridgeService"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
